# Server-side MinIO/S3-compatible storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_SECURE=false

# ETL and forecast bucket
MINIO_BUCKET=mobilesaledata

# External news bucket
MINIO_BUCKET_NEWS=news
MINIO_NEWS_PREFIX=detik_finance/

# Internal RAG source bucket. RAG never reads a local documents folder at runtime.
RAG_MINIO_ENDPOINT=http://minio:9000
RAG_MINIO_BUCKET=nexus-rag
RAG_MINIO_DOCUMENT_PREFIX=documents
